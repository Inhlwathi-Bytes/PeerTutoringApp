            android:exported="false" />
        <activity
            android:name=".PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".TutorProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".BookAppointmentActivity"
            android:exported="false" />
        <activity
            android:name=".StudentChatActivity"
            android:exported="false" />
        <activity
            android:name=".AppointmentStatusActivity"
            android:exported="false" />
        <activity
            android:name=".MyTutorsActivity"
            android:exported="false" />
        <activity
            android:name=".FindTutorActivity"
            android:exported="false" />
        <activity
            android:name=".TutorChatActivity"
            android:exported="false" />
        <activity
            android:name=".MyStudentsActivity"
            android:exported="false" />
        <activity
            android:name=".ScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".AppointmentsActivity"
            android:exported="false" />
        <activity
            android:name=".StudentRequestActivity"
            android:exported="false" />
        <activity
            android:name=".TutorDashboardActivity"
            android:exported="false"
