<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Become a Tutor on Our Platform"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share your knowledge and help others succeed while building your own reputation and experience. Register now to start tutoring students in subjects you love!"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_marginBottom="32dp" />

                <Button
                    android:id="@+id/btnStartRegistration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Registration" />
            </LinearLayout>
        </ScrollView>

        <!-- Page 1: Basic Info -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textViewStudentRegisterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register As Tutor"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    />

                <EditText
                    android:id="@+id/editTextBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bio"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                     />

                <!--                    android:gravity="top|start"-->
                <EditText
                    android:id="@+id/editTextAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Age"
                    android:inputType="number"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/editTextHighestAchievement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Highest Educational Achievement"
                    android:inputType="textMultiLine"
                    android:minLines="2" />


                <EditText
                    android:id="@+id/editTextStreet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Location(Street)"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/editTextCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="City"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/editTextProvince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Province"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/editTextPostalCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Postal Code"
                    android:inputType="number"
                    android:minLines="2" />

                <CheckBox
                    android:id="@+id/checkBoxIsAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available for tutoring" />

                <Button
                    android:id="@+id/btnNext1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next" />
            </LinearLayout>
        </ScrollView>

        <!-- Page 2: Experience & Languages -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/editTextYearsOfExperience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Years of Experience"
                    android:inputType="number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Languages Spoken:" />

                <LinearLayout
                    android:id="@+id/languageCheckboxGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <!-- inside your existing ConstraintLayout -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/languageChipGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacing="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <Button
                    android:id="@+id/selectLanguagesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Languages"
                    app:layout_constraintTop_toBottomOf="@id/languageChipGroup"
                    app:layout_constraintStart_toStartOf="parent"/>

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:weightSum="2">
                <Button
                    android:id="@+id/btnNext2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Next" />

                <Button
                    android:id="@+id/btnBack1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Back" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Page 3: Upload Photo & Submit -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <!-- Round Profile Photo -->
                <ImageView
                    android:id="@+id/imageViewProfilePhoto"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:padding="4dp" />

                <!-- Upload Photo Button -->
                <Button
                    android:id="@+id/btnUploadPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Profile Photo"
                    android:layout_marginBottom="32dp" />

                <!-- Submit and Back buttons side by side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:weightSum="2">
                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Submit" />
                    <Button
                        android:id="@+id/btnBack2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Back" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>


    </ViewFlipper>
</LinearLayout>
